#@title Telegram Login → Auto-Send Session to Bot
#@markdown 1. Enter your API ID, API HASH, and bot username.
#@markdown 2. Enter your Telegram phone number.
#@markdown 3. Enter the latest Telegram login code.
#@markdown 4. A password is requested ONLY if Telegram actually requires 2FA.
#@markdown 5. After successful login, the session string is automatically sent to your bot.

!pip install -q -U pyrogram tgcrypto

import getpass
from pyrogram import Client
from pyrogram.errors import (
    SessionPasswordNeeded,
    PhoneCodeExpired,
    PhoneCodeInvalid,
    PhoneNumberInvalid,
    PhoneNumberBanned,
    FloodWait,
    RPCError,
)
from IPython.display import display, HTML

# ============================================================
# CONFIG
# ============================================================
# Do NOT put API_HASH directly into a public/shared notebook.
API_ID = int(input("API ID: ").strip())
API_HASH = getpass.getpass("API HASH: ").strip()
BOT_USERNAME = input("Bot username without @: ").strip().lstrip("@")

# ============================================================
# PHONE
# ============================================================
phone = input("\n📱 Phone number with country code: ").strip()

# ============================================================
# IN-MEMORY CLIENT
# ============================================================
app = Client(
    "colab_login",
    api_id=API_ID,
    api_hash=API_HASH,
    in_memory=True,
)

async def main():
    print("\n🔌 Connecting to Telegram...")
    await app.connect()

    try:
        # ====================================================
        # REQUEST LOGIN CODE
        # ====================================================
        print("📩 Requesting Telegram login code...")
        sent = await app.send_code(phone)

        print("\n======================================")
        print("✅ Telegram login code sent.")
        print("======================================")

        try:
            print("Code delivery:", type(sent.type).__name__)
        except Exception:
            pass

        # ====================================================
        # OTP
        # ====================================================
        code = input("\n📩 Enter the NEWEST Telegram login code: ").strip().replace(" ", "")

        if not code.isdigit():
            print("❌ OTP must contain digits only.")
            return

        # ====================================================
        # SIGN IN
        # ====================================================
        try:
            await app.sign_in(
                phone_number=phone,
                phone_code_hash=sent.phone_code_hash,
                phone_code=code,
            )

        except SessionPasswordNeeded:
            # ONLY this exception means Telegram requires 2FA.
            print("\n🔐 Telegram requires the Cloud Password.")
            password = getpass.getpass("🔑 Enter your 2FA password: ")
            await app.check_password(password)

        except PhoneCodeExpired:
            print("\n❌ Telegram says this OTP has expired.")
            print("Request a new code and enter the newest code.")
            return

        except PhoneCodeInvalid:
            print("\n❌ Telegram says this OTP is invalid.")
            print("Make sure you entered the newest code.")
            return

        except PhoneNumberInvalid:
            print("\n❌ Invalid phone number.")
            return

        except PhoneNumberBanned:
            print("\n❌ This phone number is banned by Telegram.")
            return

        except FloodWait as e:
            print(f"\n⏳ Telegram rate limit. Wait {e.value} seconds.")
            return

        except RPCError as e:
            print("\n❌ Telegram RPC error:")
            print(type(e).__name__, str(e))
            return

        # ====================================================
        # SUCCESS
        # ====================================================
        me = await app.get_me()

        print("\n======================================")
        print("🎉 LOGIN SUCCESSFUL")
        print("======================================")
        print(f"👤 Account: {(me.first_name or '')} {(me.last_name or '')}")
        print(f"🆔 Telegram ID: {me.id}")
        print(f"📱 Phone: {me.phone}")

        # ====================================================
        # EXPORT SESSION
        # ====================================================
        session_str = await app.export_session_string()

        print("\n✅ Session string generated.")
        print(f"📏 Length: {len(session_str)} characters")

        # ====================================================
        # SEND SESSION TO YOUR BOT
        # ====================================================
        print(f"\n📤 Sending session to @{BOT_USERNAME}...")
        await app.send_message(BOT_USERNAME, session_str)
        print("✅ Session string sent to your bot.")

        # ====================================================
        # OPEN BOT BUTTON
        # ====================================================
        bot_link = f"https://t.me/{BOT_USERNAME}"

        display(HTML(f'''\
        <div style="padding:20px;border-radius:12px;background:#111;color:white;font-family:Arial;">
            <h2>✅ Login Successful</h2>
            <p>Your Telegram session has been successfully sent to the bot.</p>
            <a href="{bot_link}" target="_blank"
               style="display:inline-block;padding:12px 20px;background:#0088cc;color:white;text-decoration:none;border-radius:8px;font-size:17px;">
               📱 Open Bot
            </a>
        </div>
        '''))

    finally:
        try:
            await app.disconnect()
        except Exception:
            pass

await main()
